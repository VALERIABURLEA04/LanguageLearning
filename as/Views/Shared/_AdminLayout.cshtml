@{
    Layout = null;
    var section = (ViewContext.RouteData.Values["action"] ?? "").ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/assets/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <style>
        body { background: #f4f6f9; font-family: 'DM Sans', system-ui, sans-serif; }
        .admin-sidebar {
            position: fixed; top: 0; left: 0; bottom: 0; width: 240px;
            background: #1f2a44; color: #fff; padding: 24px 0;
        }
        .admin-sidebar .brand { padding: 0 24px 24px; font-size: 22px; font-weight: 700; border-bottom: 1px solid #2c395a; }
        .admin-sidebar a { display: block; padding: 12px 24px; color: #cfd6e6; text-decoration: none; transition: all .2s; }
        .admin-sidebar a:hover, .admin-sidebar a.active { background: #2c395a; color: #fff; border-left: 4px solid #ff6a3d; padding-left: 20px; }
        .admin-sidebar i { width: 22px; margin-right: 10px; }
        .admin-content { margin-left: 240px; padding: 32px; }
        .admin-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; }
        .admin-topbar h1 { font-size: 26px; font-weight: 700; margin: 0; }
        .stat-card { background: #fff; border-radius: 10px; padding: 22px; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
        .stat-card .label { color: #6c757d; font-size: 13px; text-transform: uppercase; letter-spacing: .5px; }
        .stat-card .value { font-size: 28px; font-weight: 700; margin-top: 6px; color: #1f2a44; }
        .stat-card .icon { float: right; font-size: 32px; opacity: .15; }
        .stat-card.c1 { border-left: 4px solid #ff6a3d; }
        .stat-card.c2 { border-left: 4px solid #4caf50; }
        .stat-card.c3 { border-left: 4px solid #2196f3; }
        .stat-card.c4 { border-left: 4px solid #9c27b0; }
        .data-card { background: #fff; border-radius: 10px; padding: 22px; box-shadow: 0 2px 8px rgba(0,0,0,.05); }
        .data-card h3 { font-size: 18px; font-weight: 700; margin-bottom: 18px; }
        table.admin-table { width: 100%; border-collapse: collapse; }
        table.admin-table th { text-align: left; padding: 12px; font-size: 12px; color: #6c757d; text-transform: uppercase; border-bottom: 2px solid #e9ecef; }
        table.admin-table td { padding: 14px 12px; border-bottom: 1px solid #f1f3f5; vertical-align: middle; }
        table.admin-table tr:hover { background: #fafbfc; }
        .badge-status { padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; text-transform: uppercase; }
        .badge-completed { background: #e6f6ea; color: #2e7d32; }
        .badge-pending   { background: #fff4e0; color: #b26a00; }
        .badge-refunded  { background: #fde7e7; color: #c62828; }
        .badge-published { background: #e6f6ea; color: #2e7d32; }
        .badge-draft     { background: #eef0f2; color: #5a6168; }
        .btn-action { padding: 6px 10px; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; margin-right: 4px; text-decoration: none; display: inline-block; }
        .btn-edit   { background: #e3f2fd; color: #1565c0; }
        .btn-delete { background: #fde7e7; color: #c62828; }
        .btn-primary-orange { background: #ff6a3d; border: none; color: #fff; padding: 10px 18px; border-radius: 8px; font-weight: 600; text-decoration: none; display: inline-block; }
        .btn-primary-orange:hover { background: #e85a2d; color: #fff; }
        .form-card { background: #fff; border-radius: 10px; padding: 32px; box-shadow: 0 2px 8px rgba(0,0,0,.05); max-width: 860px; }
        .form-card label { font-weight: 600; color: #1f2a44; margin-bottom: 6px; display: block; }
        .form-card .form-control, .form-card .form-select { border-radius: 8px; }
        .form-section-title { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #ff6a3d; padding-bottom: 8px; border-bottom: 2px solid #fff0eb; margin-bottom: 18px; margin-top: 0; }
        .inline-form { display: inline; }
    </style>
</head>
<body>
    <aside class="admin-sidebar">
        <div class="brand"><i class="fa-solid fa-graduation-cap"></i> SpeakUp Admin</div>
        <nav style="margin-top: 16px;">
            <a href="@Url.Action("Index", "Admin")"    class="@(section == "Index" ? "active" : "")"><i class="fa-solid fa-gauge"></i> Tablou de bord</a>
            <a href="@Url.Action("Courses", "Admin")"  class="@(section == "Courses" ? "active" : "")"><i class="fa-solid fa-book"></i> Cursuri</a>
            <a href="@Url.Action("Lessons", "Admin")"  class="@(section == "Lessons" ? "active" : "")"><i class="fa-solid fa-chalkboard"></i> Lecții</a>
            <a href="@Url.Action("Purchases", "Admin")" class="@(section == "Purchases" ? "active" : "")"><i class="fa-solid fa-receipt"></i> Achiziții</a>
            <a href="@Url.Action("Users", "Admin")"     class="@(section == "Users" ? "active" : "")"><i class="fa-solid fa-users"></i> Utilizatori</a>
            <a href="@Url.Action("Index", "Home")" style="margin-top: 24px; border-top: 1px solid #2c395a; padding-top: 18px;"><i class="fa-solid fa-arrow-left"></i> Înapoi la site</a>
            <a href="@Url.Action("Logout", "Admin")" style="color: #ff8a8a;"><i class="fa-solid fa-right-from-bracket"></i> Deconectare</a>
        </nav>
    </aside>
    <main class="admin-content">
        @if (TempData["Msg"] != null)
        {
            <div class="alert alert-success" style="border-radius: 10px; border: none; background: #e6f6ea; color: #2e7d32;">
                <i class="fa-solid fa-circle-check"></i> @TempData["Msg"]
            </div>
        }
        @RenderBody()
    </main>
    @if (TempData["AuthToken"] is string tok && !string.IsNullOrEmpty(tok))
    {
        <script>localStorage.setItem('lingua_token', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(tok)));</script>
    }
    @if (TempData["ClearToken"] is bool clr && clr)
    {
        <script>localStorage.removeItem('lingua_token');</script>
    }
</body>
</html>
