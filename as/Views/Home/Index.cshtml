@{
    ViewData["Title"] = "Learn English with confidence";
    Layout = "_PublicLayout";
    var courses = ViewBag.Courses as List<sa.Models.CourseRow> ?? new List<sa.Models.CourseRow>();
}

<!-- HERO -->
<section class="home_bg hb_height" style="background-image: url('/assets/img/bg/home-bg.jpg'); background-size: cover; background-position: center;">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text ht_top">
                    <h1><span>Speak English</span> with confidence — from A1 to C2</h1>
                    <p>Live lessons, smart practice and certified tutors. Pick your level and start today.</p>
                </div>
                <div class="home_sb">
                    <form action="@Url.Action("Courses", "Home")" method="get" class="banner_subs">
                        <input type="text" name="q" class="form-control home_si" placeholder="Search a course (e.g. Business, Cambridge)">
                        <button type="submit" class="subscribe__btn">Browse <i class="fa fa-paper-plane-o"></i></button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text-img">
                    <img src="~/assets/img/home-img2.png" class="img-fluid" alt="">
                    <div class="home_ps">
                        <span class="ti-user"></span>
                        <h2>@ViewBag.TotalStudents+</h2>
                        <p>Active students</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- COUNTER (real numbers from AppData) -->
<section class="count_area counter_feature">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-book sc_one"></span>
                    <h2 class="counter-num">@ViewBag.TotalCourses</h2>
                    <p>English courses</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-headphone-alt sc_two"></span>
                    <h2 class="counter-num">@ViewBag.TotalLessons</h2>
                    <p>Recorded lessons</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-user sc_three"></span>
                    <h2 class="counter-num">@ViewBag.TotalStudents</h2>
                    <p>Enrolled students</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-medall-alt sc_four"></span>
                    <h2 class="counter-num">6</h2>
                    <p>CEFR levels covered</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WHY US -->
<section class="top_cat__area section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Why learners choose Lingua</h2>
            <p>A method built around speaking, not memorising. Real conversations, real progress.</p>
        </div>
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s">
                <div class="single_tp">
                    <span class="sc_one">01</span>
                    <h3>Certified <br />Tutors</h3>
                    <p>CELTA / DELTA qualified teachers with years of classroom experience.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.3s">
                <div class="single_tp">
                    <span class="sc_two">02</span>
                    <h3>Speak from <br />Lesson One</h3>
                    <p>Every class includes guided speaking practice — you talk, we correct.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s">
                <div class="single_tp">
                    <span class="sc_three">03</span>
                    <h3>CEFR-aligned <br />Curriculum</h3>
                    <p>Each course maps to a level (A1 → C2) so progress is clear and measurable.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s">
                <div class="single_tp">
                    <span class="sc_four">04</span>
                    <h3>Cambridge <br />Exam Prep</h3>
                    <p>Dedicated preparation tracks for KET, PET, FCE, CAE and CPE.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- LEVELS -->
<section class="top_cat__area section-padding" style="background-image: url('/assets/img/bg/section-2.jpg'); background-size: cover; background-position: center;">
    <div class="container">
        <div class="section-title text-center">
            <h2>Pick your level</h2>
            <p>From your first word to fluency — there's a track for every learner.</p>
        </div>
        <div class="row">
            <div class="col-lg-12 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s">
                <div class="cat_list">
                    <ul>
                        <li><a href="@Url.Action("Courses", "Home")"><b>A1</b> Beginner</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>A2</b> Elementary</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>B1</b> Intermediate</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>B2</b> Upper-Intermediate</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>C1</b> Advanced</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>C2</b> Proficient</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>FCE</b> Cambridge</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>CAE</b> Cambridge</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>Biz</b> Business English</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>Teen</b> Teen English</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>Club</b> Conversation</a></li>
                        <li><a href="@Url.Action("Courses", "Home")"><b>IELTS</b> Prep</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURED COURSES (live from AppData) -->
<section class="course_area section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>Popular courses</h2>
            <p>Hand-picked tracks our students enrol on most.</p>
        </div>
        <div class="row">
            @{
                var featured = courses.OrderByDescending(c => c.Students).Take(6).ToList();
                var imgs = new[] { "1", "2", "3", "4", "5", "6" };
                int idx = 0;
            }
            @foreach (var c in featured)
            {
                <div class="col-lg-4 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s">
                    <div class="single_blog" style="margin-bottom: 30px;">
                        <img src="~/assets/img/course/@(imgs[idx % imgs.Length]).png" class="img-fluid" alt="@c.Title" />
                        <div class="content_box">
                            <span><b>@c.Level</b> · @c.Language · @c.Lessons lessons</span>
                            <h2><a href="@Url.Action("CourseDetail", "Home", new { id = c.Id })">@c.Title</a></h2>
                            <p><span class="ti-user"></span> @c.Students students &nbsp; <span class="ti-tag"></span> <b>$@c.Price</b></p>
                            <a class="btn_one" href="@Url.Action("CourseDetail", "Home", new { id = c.Id })">View lessons <i class="ti-arrow-top-right"></i></a>
                        </div>
                    </div>
                </div>
                idx++;
            }
        </div>
    </div>
</section>

<!-- PROMO -->
<section class="ab_area section-padding">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s">
                <div class="ab_content">
                    <h2>Why learn English with Lingua</h2>
                    <p>Most courses teach grammar. We teach communication. Every lesson is designed around real situations — meetings, travel, interviews, casual chat — so the skills transfer the moment you close your laptop.</p>
                    <ul>
                        <li><span class="ti-check"></span> Small groups (max 6 students) for real speaking time</li>
                        <li><span class="ti-check"></span> Weekly 1:1 feedback from your tutor</li>
                        <li><span class="ti-check"></span> Cambridge-aligned materials and mock exams</li>
                    </ul>
                    <a class="btn_one" href="@Url.Action("Courses", "Home")">Browse all courses <i class="ti-arrow-top-right"></i></a>
                </div>
            </div>
            <div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s">
                <div class="ab_img">
                    <img src="~/assets/img/about3.png" class="img-fluid" alt="">
                    <div class="home_ps2">
                        <span class="ti-book"></span>
                        <h2>@ViewBag.TotalCourses</h2>
                        <p>English tracks</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIALS -->
