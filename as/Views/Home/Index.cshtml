@{
    ViewData["Title"] = "Learn English with confidence";
    Layout = "_PublicLayout";
    var courses = ViewBag.Courses as List<sa.Models.CourseRow> ?? new List<sa.Models.CourseRow>();
}

<!-- HERO -->
<section class="home_bg hb_height" style="background-image: url('/assets/img/bg/home-bg.jpg'); background-size: cover; background-position: center;">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text ht_top">
                    <h1><span>Vorbește engleza</span> cu încredere — de la A1 la C2</h1>
                    <p>Lecții live, practică inteligentă și tutori certificați. Alege nivelul tău și începe azi.</p>
                </div>
                <div class="home_sb">
                    <form action="@Url.Action("Courses", "Home")" method="get" class="banner_subs">
                        <input type="text" name="q" class="form-control home_si" placeholder="Caută un curs (ex: Business, Cambridge)">
                        <button type="submit" class="subscribe__btn">Caută <i class="fa fa-paper-plane-o"></i></button>
                    </form>
                </div>
            </div>
            <div class="col-lg-6 col-sm-12 col-xs-12">
                <div class="hero-text-img">
                    <img src="~/assets/img/home-img2.png" class="img-fluid" alt="">
                    <div class="home_ps">
                        <span class="ti-user"></span>
                        <h2>@ViewBag.TotalStudents+</h2>
                        <p>Studenți activi</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- COUNTER (real numbers from AppData) -->
<section class="count_area counter_feature">
    <div class="container">
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-book sc_one"></span>
                    <h2 class="counter-num">@ViewBag.TotalCourses</h2>
                    <p>Cursuri de engleză</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-headphone-alt sc_two"></span>
                    <h2 class="counter-num">@ViewBag.TotalLessons</h2>
                    <p>Lecții înregistrate</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-user sc_three"></span>
                    <h2 class="counter-num">@ViewBag.TotalStudents</h2>
                    <p>Studenți înscriși</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12">
                <div class="single-counter">
                    <span class="ti-medall-alt sc_four"></span>
                    <h2 class="counter-num">6</h2>
                    <p>Niveluri CEFR acoperite</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WHY US -->
<section class="top_cat__area section-padding">
    <div class="container">
        <div class="section-title text-center">
            <h2>De ce aleg cursanții SpeakUp</h2>
            <p>O metodă construită în jurul vorbirii, nu al memoratului. Conversații reale, progres real.</p>
        </div>
        <div class="row">
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s">
                <div class="single_tp">
                    <span class="sc_one">01</span>
                    <h3>Tutori <br />Certificați</h3>
                    <p>Profesori calificați CELTA / DELTA cu ani de experiență în sală de clasă.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.3s">
                <div class="single_tp">
                    <span class="sc_two">02</span>
                    <h3>Vorbești de la <br />Prima Lecție</h3>
                    <p>Fiecare clasă include practică ghidată de vorbire — tu vorbești, noi corectăm.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s">
                <div class="single_tp">
                    <span class="sc_three">03</span>
                    <h3>Curriculum <br />Aliniat CEFR</h3>
                    <p>Fiecare curs corespunde unui nivel (A1 → C2) — progresul tău e clar și măsurabil.</p>
                </div>
            </div>
            <div class="col-lg-3 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.4s">
                <div class="single_tp">
                    <span class="sc_four">04</span>
                    <h3>Pregătire <br />Examene Cambridge</h3>
                    <p>Programe dedicate pentru KET, PET, FCE, CAE și CPE.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- COURSE CATEGORIES (from DB) -->
<section class="top_cat__area section-padding" style="background: #f8f9fb;">
    <div class="container">
        <div class="section-title text-center">
            <h2>Cursuri de engleză în Chișinău</h2>
            <p>Alege programul potrivit pentru tine — de la copii la adulți, de la conversație la examene.</p>
        </div>
        @if (!courses.Any())
        {
            <div class="text-center py-5">
                <p style="color:#aaa; font-size:18px; margin-bottom:20px;">Nu există cursuri disponibile momentan.</p>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Courses" class="btn_one">+ Adaugă primul curs</a>
                }
            </div>
        }
        else
        {
            var fallbackColors = new[] { "#FF6B35", "#FFB800", "#7B2FBE", "#00B4D8", "#1B3A6B", "#0CA678" };
            int catIdx = 0;
            <div class="row">
            @foreach (var course in courses)
            {
                var bg = !string.IsNullOrEmpty(course.BackgroundColor) ? course.BackgroundColor : fallbackColors[catIdx % fallbackColors.Length];
                <div class="col-lg-4 col-md-6 col-sm-6 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="@(0.1 + catIdx * 0.05)s">
                    <a href="@Url.Action("CourseDetail", "Home", new { id = course.Id })" class="category-card" style="text-decoration:none;color:inherit;display:block;">
                        <div style="background:@bg;border-radius:22px;padding:32px 30px;min-height:200px;position:relative;overflow:hidden;margin-bottom:30px;transition:transform .25s ease,box-shadow .25s ease;">
                            @if (!string.IsNullOrEmpty(course.Icon))
                            {
                                <div style="font-size:36px;margin-bottom:8px;line-height:1;">@course.Icon</div>
                            }
                            <span style="display:inline-block;background:rgba(255,255,255,.25);color:#fff;font-size:12px;font-weight:600;padding:4px 12px;border-radius:12px;margin-bottom:10px;">@course.Level · @course.Language</span>
                            <h3 style="color:#fff;font-weight:700;font-size:22px;line-height:1.3;margin:0 0 18px;max-width:70%;">@course.Title</h3>
                            <span style="display:inline-block;background:#fff;color:#1f2a44;padding:10px 28px;border-radius:26px;font-weight:600;font-size:14px;box-shadow:0 4px 12px rgba(0,0,0,.08);">Detalii</span>
                            @if (!string.IsNullOrEmpty(course.ImageUrl))
                            {
                                <img src="@course.ImageUrl" alt="@course.Title"
                                     style="position:absolute;right:-10px;bottom:0;max-height:160px;max-width:45%;object-fit:contain;pointer-events:none;opacity:.9;"
                                     onerror="this.style.display='none'" />
                            }
                        </div>
                    </a>
                </div>
                catIdx++;
            }
            </div>
        }
    </div>
</section>

<style>
    .category-card:hover > div {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(0,0,0,.15);
    }
</style>



<!-- TESTIMONIALS -->
<section class="section-padding" style="background:#f8f9fb;">
    <div class="container">
        <div class="section-title text-center">
            <h2>Ce spun studenții noștri</h2>
            <p>Peste 500 de cursanți și-au îmbunătățit engleza cu SpeakUp. Iată câteva povești reale.</p>
        </div>

        @{
            var reviews = new[]
            {
                new { Name="Maria P.",   Role="Project Manager — București",  Color="#FF6B35", Text="Am trecut de la a tăcea în ședințe la a le conduce în engleză. Cursul B2→C1 era exact ce aveam nevoie. Tutorele m-a corectat cu răbdare la fiecare lecție.", Stars=5 },
                new { Name="Andrei I.",  Role="Student — Cluj-Napoca",         Color="#7B2FBE", Text="Am luat FCE din prima. Simulările de examen și feedback-ul personalizat al tutorilor au făcut toată diferența. Recomand oricui vizează Cambridge.", Stars=5 },
                new { Name="Elena C.",   Role="Designer UX — Chișinău",        Color="#00B4D8", Text="Clubul de conversație m-a ajutat să nu mai gândesc în română înainte să vorbesc. Acum reacționez natural. A meritat fiecare leu investit.", Stars=5 },
                new { Name="Victor M.",  Role="Inginer software — Iași",       Color="#0CA678", Text="Engleza tehnică nu se prea predă la cursuri obișnuite. La SpeakUp au adaptat conținutul pentru IT, cu vocabular real din industrie. Perfect.", Stars=5 },
                new { Name="Ioana T.",   Role="Mamă, 34 ani — Chișinău",       Color="#FFB800", Text="Fiul meu de 10 ani adoră lecțiile. Tutoarea e super răbdătoare, jocurile sunt distractive și el nu mai simte că e la școală. Progres vizibil în 2 luni.", Stars=5 },
                new { Name="Radu F.",    Role="Antreprenor — Timișoara",        Color="#1B3A6B", Text="Am nevoie de engleză pentru negocieri cu parteneri din UK. Cursul Business English mi-a dat exact formulele și încrederea de care aveam nevoie.", Stars=5 },
                new { Name="Cristina B.",Role="Profesoară — Bălți",            Color="#E91E8C", Text="M-am înscris cu zero experiență și în 6 luni am ajuns la A2 solid. Grupul mic înseamnă că tutorele îți acordă atenție reală, nu ești pierdut.", Stars=5 },
                new { Name="Mihai D.",   Role="Medic rezident — București",    Color="#FF6B35", Text="Programul seral e ideal pentru oameni cu job. Lecțiile de 90 min de două ori pe săptămână se integrează perfect în orar fără să fiu epuizat.", Stars=5 },
            };
        }

        <div class="row">
            @foreach (var r in reviews)
            {
                <div class="col-lg-3 col-md-6 col-sm-12" style="margin-bottom:28px;">
                    <div style="background:#fff;border-radius:18px;padding:26px 24px;height:100%;
                                box-shadow:0 4px 18px rgba(0,0,0,.07);display:flex;flex-direction:column;">
                        <div style="display:flex;gap:4px;margin-bottom:14px;">
                            @for (int s = 0; s < r.Stars; s++)
                            {
                                <i class="fa-solid fa-star" style="color:#FFB800;font-size:13px;"></i>
                            }
                        </div>
                        <p style="color:#444;font-size:14px;line-height:1.7;flex:1;margin:0 0 20px;">
                            &ldquo;@r.Text&rdquo;
                        </p>
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div style="width:42px;height:42px;border-radius:50%;background:@r.Color;
                                        color:#fff;font-weight:700;font-size:16px;flex-shrink:0;
                                        display:flex;align-items:center;justify-content:center;">
                                @r.Name[0]
                            </div>
                            <div>
                                <div style="font-weight:700;color:#1f2a44;font-size:14px;">@r.Name</div>
                                <div style="color:#9aa0a6;font-size:12px;">@r.Role</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
