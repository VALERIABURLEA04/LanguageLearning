@using System.Security.Claims
@model sa.Models.CourseCategory
@{
    ViewData["Title"] = "Achitare — " + Model.Title;
    Layout = "_PublicLayout";
    var fullPriceInstallment = Model.Price / 3;

    var isAuth     = User?.Identity?.IsAuthenticated ?? false;
    var profileName  = User?.Identity?.Name ?? "";
    var profileEmail = User?.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var readonlyAttr = isAuth ? "readonly" : "";
    var lockedStyle  = isAuth ? "background: #f4f6fb; cursor: not-allowed;" : "";
}

<section class="page-title" style="background: linear-gradient(135deg, @Model.BackgroundColor 0%, @Model.BackgroundColor 60%, rgba(0,0,0,.18) 100%); padding: 80px 0 60px; color: #fff;">
    <div class="container">
        <span style="background: rgba(255,255,255,.18); padding: 7px 16px; border-radius: 22px; font-size: 13px; font-weight: 600;">
            <i class="fa-solid fa-lock"></i> Achitare securizată
        </span>
        <h1 style="font-size: 38px; font-weight: 700; margin-top: 18px;">Finalizează înscrierea</h1>
        <p style="font-size: 16px; opacity: .95; margin-top: 8px;">Curs: <b>@Model.Title</b></p>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        @if (TempData["Error"] != null)
        {
            <div style="background: #fdecea; color: #b3261e; padding: 14px 22px; border-radius: 12px; margin-bottom: 22px; display: flex; align-items: center; gap: 12px;">
                <i class="fa-solid fa-triangle-exclamation" style="font-size: 20px;"></i>
                <div>@TempData["Error"]</div>
            </div>
        }
        <form method="post" action="@Url.Action("Checkout", "Home", new { id = Model.Slug })">
            @Html.AntiForgeryToken()
            <div class="row">

                <!-- LEFT: FORM -->
                <div class="col-lg-7 col-md-12">

                    <!-- Date personale -->
                    <div style="background: #fff; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,.07); padding: 28px; margin-bottom: 24px;">
                        <h3 style="font-weight: 700; font-size: 20px; margin: 0 0 18px; color: #1f2a44;">
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: @(Model.BackgroundColor)22; color: @Model.BackgroundColor; font-size: 14px; margin-right: 8px;">1</span>
                            Datele tale
                        </h3>

                        @if (isAuth)
                        {
                            <div style="background: #eef5ff; color: #1f3a8a; padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                                <i class="fa-solid fa-circle-info"></i>
                                <span>Datele sunt preluate din profilul tău. Le poți actualiza din <a href="@Url.Action("Profile", "Home")" style="color: #1f3a8a; font-weight: 600; text-decoration: underline;">Profil</a>.</span>
                            </div>
                        }
                        else
                        {
                            <div style="background: #fff8e6; color: #8a5a00; padding: 10px 14px; border-radius: 10px; font-size: 13px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                                <i class="fa-solid fa-user-lock"></i>
                                <span>Ai cont? <a href="@Url.Action("Login", "Home")" style="color: #8a5a00; font-weight: 600; text-decoration: underline;">Autentifică-te</a> ca să precompletăm datele.</span>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-12" style="margin-bottom: 14px;">
                                <label style="display: block; font-weight: 600; color: #1f2a44; margin-bottom: 6px; font-size: 14px;">Nume complet</label>
                                <input type="text" name="fullName" required class="form-control"
                                       value="@profileName" @Html.Raw(readonlyAttr)
                                       style="border: 1.5px solid #e6e8f0; border-radius: 10px; padding: 12px 14px; width: 100%; @lockedStyle"
                                       placeholder="ex: Maria Popescu" />
                            </div>
                            <div class="col-md-6" style="margin-bottom: 14px;">
                                <label style="display: block; font-weight: 600; color: #1f2a44; margin-bottom: 6px; font-size: 14px;">Email</label>
                                <input type="email" name="email" required class="form-control"
                                       value="@profileEmail" @Html.Raw(readonlyAttr)
                                       style="border: 1.5px solid #e6e8f0; border-radius: 10px; padding: 12px 14px; width: 100%; @lockedStyle"
                                       placeholder="email@exemplu.com" />
                            </div>
                            <div class="col-md-6" style="margin-bottom: 14px;">
                                <label style="display: block; font-weight: 600; color: #1f2a44; margin-bottom: 6px; font-size: 14px;">Telefon</label>
                                <input type="tel" name="phone" required class="form-control"
                                       style="border: 1.5px solid #e6e8f0; border-radius: 10px; padding: 12px 14px; width: 100%;"
                                       placeholder="+373 ..." />
                            </div>
                        </div>
                    </div>

                    <!-- Plan -->
                    <div style="background: #fff; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,.07); padding: 28px; margin-bottom: 24px;">
                        <h3 style="font-weight: 700; font-size: 20px; margin: 0 0 18px; color: #1f2a44;">
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: @(Model.BackgroundColor)22; color: @Model.BackgroundColor; font-size: 14px; margin-right: 8px;">2</span>
                            Plan de plată
                        </h3>

                        <label style="display: flex; align-items: center; gap: 14px; border: 2px solid @Model.BackgroundColor; background: @(Model.BackgroundColor)11; border-radius: 12px; padding: 16px 18px; margin-bottom: 12px; cursor: pointer;">
                            <input type="radio" name="plan" value="full" checked style="width: 18px; height: 18px;">
                            <div style="flex: 1;">
                                <div style="font-weight: 700; color: #1f2a44;">Plată integrală</div>
                                <small style="color: #6c757d;">Achită acum toată suma și beneficiezi de reducere</small>
                            </div>
                            <div style="text-align: right;">
                                <div style="color: #16a34a; font-weight: 700; font-size: 20px;">@Model.Price.ToString("N0") @Model.PriceUnit</div>
                                @if (Model.DiscountPercent > 0)
                                {
                                    <small style="color: #9aa0a6; text-decoration: line-through;">@Model.OldPrice.ToString("N0") @Model.PriceUnit</small>
                                }
                            </div>
                        </label>

                        <label style="display: flex; align-items: center; gap: 14px; border: 2px solid #e6e8f0; border-radius: 12px; padding: 16px 18px; cursor: pointer;">
                            <input type="radio" name="plan" value="installments" style="width: 18px; height: 18px;">
                            <div style="flex: 1;">
                                <div style="font-weight: 700; color: #1f2a44;">Plată în rate (3 luni)</div>
                                <small style="color: #6c757d;">Fără dobândă, acces complet din prima zi</small>
                            </div>
                            <div style="text-align: right;">
                                <div style="color: #1f2a44; font-weight: 700; font-size: 20px;">@fullPriceInstallment.ToString("N0") @Model.PriceUnit<small style="font-weight: 500; color: #6c757d;"> / lună</small></div>
                                <small style="color: #6c757d;">total @Model.Price.ToString("N0") @Model.PriceUnit</small>
                            </div>
                        </label>
                    </div>

                    <!-- Metoda de plata -->
                    <div style="background: #fff; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,.07); padding: 28px; margin-bottom: 24px;">
                        <h3 style="font-weight: 700; font-size: 20px; margin: 0 0 18px; color: #1f2a44;">
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; background: @(Model.BackgroundColor)22; color: @Model.BackgroundColor; font-size: 14px; margin-right: 8px;">3</span>
                            Metoda de plată
                        </h3>

                        <div class="row">
                            @{
                                var methods = new[] {
                                    new { Value = "card",    Label = "Card bancar",     Icon = "fa-credit-card",         Note = "Visa, Mastercard, Maestro" },
                                    new { Value = "stripe",  Label = "Stripe",          Icon = "fa-brands fa-stripe-s",  Note = "Plată online securizată" },
                                    new { Value = "paypal",  Label = "PayPal",          Icon = "fa-brands fa-paypal",    Note = "Cont PayPal sau card" },
                                    new { Value = "bank",    Label = "Transfer bancar", Icon = "fa-building-columns",    Note = "Pentru companii" }
                                };
                            }
                            @foreach (var m in methods)
                            {
                                <div class="col-md-6" style="margin-bottom: 12px;">
                                    <label style="display: flex; align-items: center; gap: 12px; border: 2px solid #e6e8f0; border-radius: 12px; padding: 14px 16px; cursor: pointer; height: 100%;">
                                        <input type="radio" name="paymentMethod" value="@m.Value" @(m.Value == "card" ? "checked" : "") style="width: 16px; height: 16px;">
                                        <i class="fa-solid @m.Icon" style="font-size: 22px; color: @Model.BackgroundColor;"></i>
                                        <div>
                                            <div style="font-weight: 700; color: #1f2a44; font-size: 14px;">@m.Label</div>
                                            <small style="color: #6c757d;">@m.Note</small>
                                        </div>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                </div>

                <!-- RIGHT: SUMMARY -->
                <div class="col-lg-5 col-md-12">
                    <div style="background: #fff; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,.07); padding: 28px; position: sticky; top: 100px;">
                        <h3 style="font-weight: 700; font-size: 20px; margin: 0 0 18px; color: #1f2a44;">Sumar comandă</h3>

                        <div style="display: flex; gap: 14px; align-items: center; padding-bottom: 18px; border-bottom: 1px solid #f1f3f5; margin-bottom: 18px;">
                            <div style="width: 64px; height: 64px; border-radius: 12px; background: @Model.BackgroundColor; display: flex; align-items: center; justify-content: center; font-size: 32px;">@Model.Icon</div>
                            <div style="flex: 1;">
                                <div style="font-weight: 700; color: #1f2a44;">@Model.Title</div>
                                <small style="color: #6c757d;">@Model.Level · @Model.Duration</small>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px; color: #555;">
                            <span>Preț listă</span>
                            @if (Model.OldPrice > Model.Price)
                            {
                                <span style="text-decoration: line-through; color: #9aa0a6;">@Model.OldPrice.ToString("N0") @Model.PriceUnit</span>
                            }
                            else
                            {
                                <span>@Model.Price.ToString("N0") @Model.PriceUnit</span>
                            }
                        </div>
                        @if (Model.DiscountPercent > 0)
                        {
                            <div style="display: flex; justify-content: space-between; margin-bottom: 10px; color: #16a34a; font-weight: 600;">
                                <span>Reducere (-@Model.DiscountPercent%)</span>
                                <span>-@((Model.OldPrice - Model.Price).ToString("N0")) @Model.PriceUnit</span>
                            </div>
                        }
                        <div style="display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px solid #f1f3f5; font-weight: 700; color: #1f2a44; font-size: 18px;">
                            <span>Total</span>
                            <span style="color: #16a34a; font-size: 24px;">@Model.Price.ToString("N0") @Model.PriceUnit</span>
                        </div>

                        <button type="submit" style="width: 100%; background: @Model.BackgroundColor; color: #fff; border: none; padding: 16px; border-radius: 30px; font-weight: 700; font-size: 16px; margin-top: 22px; cursor: pointer;">
                            <i class="fa-solid fa-lock" style="margin-right: 6px;"></i> Confirmă achitarea
                        </button>

                        <a href="@Url.Action("Category", "Home", new { id = Model.Slug })" style="display: block; text-align: center; padding: 12px; color: #6c757d; text-decoration: none; font-weight: 500; margin-top: 6px;">
                            <i class="ti-arrow-left"></i> Înapoi la curs
                        </a>

                        <hr style="margin: 20px 0;">

                        <ul style="list-style: none; padding: 0; color: #6c757d; font-size: 13px;">
                            <li style="margin-bottom: 8px;"><i class="fa-solid fa-shield-halved" style="color: #16a34a; margin-right: 8px;"></i> Plată 100% securizată (SSL)</li>
                            <li style="margin-bottom: 8px;"><i class="fa-solid fa-rotate-left" style="color: #16a34a; margin-right: 8px;"></i> Rambursare în primele 14 zile</li>
                            <li><i class="fa-solid fa-headset" style="color: #16a34a; margin-right: 8px;"></i> Suport 7 zile/7</li>
                        </ul>
                    </div>
                </div>

            </div>
        </form>
    </div>
</section>
