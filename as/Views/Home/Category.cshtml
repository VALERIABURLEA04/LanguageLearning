@model sa.Models.CourseCategory
@{
    ViewData["Title"] = Model.Title;
    Layout = "_PublicLayout";
    var allCategories = sa.Models.CourseCategory.All;
}

<section class="page-title" style="background: linear-gradient(135deg, @Model.BackgroundColor 0%, @Model.BackgroundColor 60%, rgba(0,0,0,0.25) 100%); padding: 120px 0 100px; color: #fff;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <span style="background: rgba(255,255,255,.18); padding: 8px 16px; border-radius: 22px; font-size: 13px; font-weight: 600; letter-spacing: .5px;">
                    @Model.Level &nbsp;·&nbsp; @Model.Duration
                </span>
                <h1 style="font-size: 48px; font-weight: 700; margin-top: 20px; line-height: 1.15;">@Model.Title</h1>
                <p style="font-size: 18px; opacity: .95; margin-top: 14px; max-width: 560px;">@Model.Description</p>
                <div style="margin-top: 30px;">
                    <a href="@Url.Action("Courses", "Home")" class="btn_one">Vezi toate cursurile <i class="ti-arrow-top-right"></i></a>
                    <a href="@Url.Action("Contact", "Home")" style="margin-left: 14px; color: #fff; padding: 13px 26px; border: 2px solid rgba(255,255,255,.6); border-radius: 30px; text-decoration: none; font-weight: 600; display: inline-block;">Contactează-ne</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block text-end">
                <img src="@Model.Image" class="img-fluid" alt="@Model.Title" style="max-height: 340px; filter: drop-shadow(0 20px 40px rgba(0,0,0,.25));">
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        @if (TempData["Msg"] != null)
        {
            <div style="background: #e6f6ea; color: #2e7d32; padding: 16px 22px; border-radius: 12px; margin-bottom: 26px; display: flex; align-items: center; gap: 12px;">
                <i class="fa-solid fa-circle-check" style="font-size: 22px;"></i>
                <div>@TempData["Msg"]</div>
            </div>
        }
        <div class="row">
            <div class="col-lg-8 col-sm-12">
                <h2 style="margin-bottom: 18px; font-weight: 700;">Despre acest curs</h2>
                <p style="color: #555; line-height: 1.8; font-size: 16px;">@Model.LongDescription</p>

                <h2 style="margin: 40px 0 20px; font-weight: 700;">Ce include cursul</h2>
                <div style="background: #fff; border-radius: 12px; box-shadow: 0 2px 10px rgba(0,0,0,.05); padding: 10px 0;">
                    @foreach (var feature in Model.Features)
                    {
                        <div style="display: flex; align-items: center; padding: 16px 22px; border-bottom: 1px solid #f1f3f5;">
                            <div style="width: 38px; height: 38px; border-radius: 50%; background: @(Model.BackgroundColor)22; color: @Model.BackgroundColor; display: flex; align-items: center; justify-content: center; margin-right: 16px;">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <span style="color: #1f2a44; font-weight: 500;">@feature</span>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4 col-sm-12">
                <div style="background: #fff; border-radius: 14px; box-shadow: 0 4px 20px rgba(0,0,0,.08); padding: 30px; position: sticky; top: 100px;">
                    <div style="font-size: 13px; font-weight: 700; color: @Model.BackgroundColor; text-transform: uppercase; letter-spacing: 1px;">Înscriere rapidă</div>
                    <h3 style="font-size: 24px; font-weight: 700; margin: 10px 0 6px; color: #1f2a44;">@Model.Title</h3>
                    <p style="color: #6c757d; margin-bottom: 22px;">@Model.Level · @Model.Duration</p>

                    <a href="@Url.Action("Courses", "Home")" class="btn_one" style="display: block; text-align: center; margin-bottom: 12px; background: @Model.BackgroundColor; border-color: @Model.BackgroundColor;">Înscrie-te acum <i class="ti-arrow-top-right"></i></a>
                    <a href="@Url.Action("Contact", "Home")" style="display: block; text-align: center; padding: 12px; color: #6c757d; text-decoration: none; font-weight: 500;">Solicită informații</a>

                    <hr style="margin: 22px 0;">

                    <h5 style="font-weight: 700; margin-bottom: 14px;">Avantajele tale</h5>
                    <ul style="list-style: none; padding: 0; color: #555;">
                        <li style="margin-bottom: 10px;"><span class="ti-check" style="color: #2e7d32; margin-right: 8px;"></span> Lecție demonstrativă gratuită</li>
                        <li style="margin-bottom: 10px;"><span class="ti-check" style="color: #2e7d32; margin-right: 8px;"></span> Plată în rate fără dobândă</li>
                        <li style="margin-bottom: 10px;"><span class="ti-check" style="color: #2e7d32; margin-right: 8px;"></span> Garanție 14 zile</li>
                        <li><span class="ti-check" style="color: #2e7d32; margin-right: 8px;"></span> Acces nelimitat la platformă</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TARIFE -->
<section class="section-padding" style="background: #2c63ff;">
    <div class="container">
        <div class="section-title text-center">
            <h2 style="color: #fff;">Tarife</h2>
            <p style="color: rgba(255,255,255,.85);">Alege pachetul potrivit. Toate prețurile includ acces complet și suport din partea profesorului.</p>
        </div>
        <div class="row">
            @foreach (var cat in allCategories)
            {
                var isCurrent = cat.Slug == Model.Slug;
                <div class="col-lg-3 col-md-6 col-sm-6 col-xs-12">
                    <div class="price-card" style="background: #fff; border-radius: 22px; box-shadow: @(isCurrent ? "0 18px 40px rgba(0,0,0,.25)" : "0 8px 20px rgba(0,0,0,.12)"); padding: 26px 24px 28px; margin-bottom: 30px; height: calc(100% - 30px); display: flex; flex-direction: column; transition: transform .25s ease, box-shadow .25s ease; @(isCurrent ? "transform: translateY(-8px);" : "")">

                        <!-- Icon + flag -->
                        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 14px;">
                            <span style="display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 50%; background: #fff3d6; font-size: 24px;">@cat.Icon</span>
                            <span style="font-size: 28px; line-height: 1;">🇬🇧</span>
                        </div>

                        <!-- Title -->
                        <h3 style="font-weight: 700; font-size: 20px; line-height: 1.25; color: #1f2a44; min-height: 54px; white-space: pre-line; margin: 0 0 18px;">@cat.ShortTitle</h3>

                        <!-- Frecvență -->
                        @if (!string.IsNullOrEmpty(cat.Frequency))
                        {
                            <div style="color: #6c757d; font-size: 13px;">Frecvență</div>
                            <div style="color: #1f2a44; font-weight: 700; margin-bottom: 12px;">@cat.Frequency</div>
                        }

                        <!-- Durata -->
                        <div style="color: #6c757d; font-size: 13px;">@cat.DurationLabel</div>
                        <div style="color: #1f2a44; font-weight: 700; margin-bottom: 14px;">@cat.Duration</div>

                        <!-- Prețuri -->
                        <div style="color: #6c757d; font-size: 13px;">@cat.PriceLabel</div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="color: #16a34a; font-size: 24px; font-weight: 700;">@cat.Price.ToString("N0") @cat.PriceUnit</span>
                            @if (cat.DiscountPercent > 0)
                            {
                                <span style="background: #16a34a; color: #fff; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 12px;">-@cat.DiscountPercent%</span>
                            }
                        </div>
                        @if (cat.OldPrice > cat.Price)
                        {
                            <div style="color: #b9bdc4; text-decoration: line-through; font-weight: 600; margin-bottom: 14px; font-size: 15px;">@cat.OldPrice.ToString("N0") @cat.PriceUnit</div>
                        }
                        else
                        {
                            <div style="margin-bottom: 14px;"></div>
                        }

                        <!-- Note pill -->
                        @if (!string.IsNullOrEmpty(cat.PriceNote))
                        {
                            <div style="display: inline-flex; align-items: center; gap: 6px; border: 1.5px solid #d8d8f0; color: #4f5b8c; padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 500; align-self: flex-start; margin-bottom: 18px;">
                                <i class="fa-solid fa-star" style="color: #ff9b3d; font-size: 10px;"></i> @cat.PriceNote
                            </div>
                        }

                        <a href="@Url.Action("Checkout", "Home", new { id = cat.Slug })"
                           style="margin-top: auto; display: block; text-align: center; background: @cat.BackgroundColor; color: #fff; padding: 13px; border-radius: 26px; text-decoration: none; font-weight: 700; font-size: 15px;">
                            <i class="fa-solid fa-lock" style="font-size: 13px; margin-right: 4px;"></i> Spre achitare
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .price-card:hover {
        transform: translateY(-10px) !important;
        box-shadow: 0 22px 44px rgba(0,0,0,.22) !important;
    }
</style>
