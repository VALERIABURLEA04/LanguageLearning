@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Creează cont - SpeakUp</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; font-family: 'DM Sans', sans-serif; background: #f6f7fb; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; }
        .card { width: 100%; max-width: 380px; background: #fff; padding: 36px 32px; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,.06); }
        .brand { text-align: center; font-size: 22px; font-weight: 700; color: #ff6a3d; margin-bottom: 24px; }
        h1 { font-size: 22px; font-weight: 600; color: #1f2a44; margin: 0 0 4px; text-align: center; }
        .subtitle { color: #6c757d; text-align: center; font-size: 14px; margin-bottom: 24px; }
        label { display: block; font-size: 13px; font-weight: 500; color: #1f2a44; margin-bottom: 6px; }
        input { width: 100%; padding: 11px 14px; border: 1px solid #e1e5ea; border-radius: 8px; font-size: 14px; font-family: inherit; margin-bottom: 14px; }
        input:focus { outline: none; border-color: #ff6a3d; }
        .pwd-wrap { position: relative; margin-bottom: 14px; }
        .pwd-wrap input { margin-bottom: 0; padding-right: 42px; }
        .pwd-toggle { position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; padding: 0; width: auto; cursor: pointer; color: #aaa; font-size: 16px; }
        .pwd-toggle:hover { color: #ff6a3d; background: none; }
        button { width: 100%; padding: 12px; background: #ff6a3d; color: #fff; border: none; border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer; }
        button:hover { background: #e85a2d; }
        .footer { text-align: center; margin-top: 18px; font-size: 14px; color: #6c757d; }
        .footer a { color: #ff6a3d; font-weight: 600; text-decoration: none; }
        .error { background: #fde7e7; color: #c62828; padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 18px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="brand">SpeakUp</div>
        <h1>Creează cont</h1>
        <p class="subtitle">Începe să înveți azi</p>

        @if (ViewBag.Error != null)
        {
            <div class="error">@ViewBag.Error</div>
        }

        <form asp-action="Register" asp-controller="Home" method="post">
            <label>Nume complet</label>
            <input type="text" name="name" required autofocus>

            <label>Email</label>
            <input type="email" name="email" required>

            <label>Parolă</label>
            <div class="pwd-wrap">
                <input type="password" name="password" id="pwd" required minlength="6">
                <button type="button" class="pwd-toggle" onclick="togglePwd('pwd','eyeReg')">
                    <i class="fa-regular fa-eye" id="eyeReg"></i>
                </button>
            </div>

            <button type="submit">Creează cont</button>
        </form>

        <div class="footer">
            Ai deja un cont? <a asp-action="Login" asp-controller="Home">Conectează-te</a>
        </div>
    </div>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <script>
        function togglePwd(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon  = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
            }
        }
    </script>
</body>
</html>
