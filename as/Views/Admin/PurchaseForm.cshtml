@model sa.Models.Purchase
@{
    ViewData["Title"] = ViewBag.FormTitle as string ?? "Purchase";
    Layout = "_AdminLayout";
    var isEdit = Model.Id > 0;
    var action = isEdit ? "EditPurchase" : "CreatePurchase";
    var courses = ViewBag.CourseTitles as List<string> ?? new List<string>();
}

<div class="admin-topbar">
    <h1>@ViewBag.FormTitle</h1>
    <a href="@Url.Action("Purchases", "Admin")" class="btn-action btn-edit"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-card">
    <form asp-action="@action" asp-controller="Admin" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="StudentName">Student Name</label>
                <input asp-for="StudentName" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="CourseTitle">Course</label>
                <select asp-for="CourseTitle" class="form-select">
                    @foreach (var t in courses)
                    {
                        <option value="@t" selected="@(t == Model.CourseTitle)">@t</option>
                    }
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Amount">Amount ($)</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="PaymentMethod">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option>Stripe</option><option>PayPal</option><option>Card</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Status"></label>
                <select asp-for="Status" class="form-select">
                    <option>Completed</option><option>Pending</option><option>Refunded</option>
                </select>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="PurchaseDate">Purchase Date</label>
            <input asp-for="PurchaseDate" type="datetime-local" class="form-control" />
        </div>

        <button type="submit" class="btn-primary-orange"><i class="fa-solid fa-floppy-disk"></i> @(isEdit ? "Update" : "Create")</button>
    </form>
</div>
