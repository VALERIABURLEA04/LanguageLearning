@model sa.Models.CourseRow
@{
    ViewData["Title"] = ViewBag.FormTitle as string ?? "Course";
    Layout = "_AdminLayout";
    var isEdit = Model.Id > 0;
    var action = isEdit ? "EditCourse" : "CreateCourse";
}

<div class="admin-topbar">
    <h1>@ViewBag.FormTitle</h1>
    <a href="@Url.Action("Courses", "Admin")" class="btn-action btn-edit"><i class="fa-solid fa-arrow-left"></i> Back</a>
</div>

<div class="form-card">
    <form asp-action="@action" asp-controller="Admin" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Title"></label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Language"></label>
                <input asp-for="Language" class="form-control" required />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Level"></label>
                <select asp-for="Level" class="form-select">
                    <option>A1</option><option>A2</option><option>B1</option><option>B2</option><option>C1</option><option>C2</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Price">Price ($)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Lessons"></label>
                <input asp-for="Lessons" type="number" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Students"></label>
                <input asp-for="Students" type="number" class="form-control" />
            </div>
        </div>

        <button type="submit" class="btn-primary-orange"><i class="fa-solid fa-floppy-disk"></i> @(isEdit ? "Update" : "Create")</button>
    </form>
</div>
