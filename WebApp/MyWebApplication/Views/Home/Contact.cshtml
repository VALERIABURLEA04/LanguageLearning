@{
	Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta name="description" content="Contact Eduleb">
	<meta name="keywords" content="education, online courses, contact, support">
	<title>Contact - Eduleb</title>
	<link rel="stylesheet" href="~/assets/bootstrap/css/bootstrap.min.css">
	<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
	<link rel="stylesheet" href="~/assets/fonts/font-awesome.min.css">
	<link rel="stylesheet" href="~/assets/fonts/themify-icons.css">
	<link rel="stylesheet" href="~/assets/owlcarousel/css/owl.carousel.css">
	<link rel="stylesheet" href="~/assets/owlcarousel/css/owl.theme.css">
	<link rel="stylesheet" href="~/assets/css/jquery-simple-mobilemenu.css">
	<link rel="stylesheet" href="~/assets/css/magnific-popup.css">
	<link rel="stylesheet" href="~/assets/css/animate.css">
	<link rel="stylesheet" href="~/assets/css/style.css">
	<style>
		.contact_area .map iframe {
			margin-left: 0;
		}
	</style>
</head>

<body data-spy="scroll" data-offset="80">

	<div class="preloaders">
		<span class="loader"></span>
	</div>

	<div id="navigation" class="navbar-light bg-faded site-navigation">
		<div class="container-fluid">
			<div class="row">
				<div class="col-20 align-self-center">
					<div class="site-logo">
						<a href="@Url.Action("Index", "Home")"><img src="~/assets/img/logo.png" alt="Eduleb"></a>
					</div>
				</div>

				<div class="col-60 d-flex">
					<nav id="main-menu">
						<ul>
							<li><a href="@Url.Action("Index", "Home")">Home</a></li>
							<li><a href="#">About</a></li>
							<li class="menu-item-has-children">
								<a href="@Url.Action("Courses", "Home")">Course</a>
								<ul>
									<li><a href="@Url.Action("Courses", "Home")">Course</a></li>
									<li><a href="#">Course Details</a></li>
								</ul>
							</li>
							<li class="menu-item-has-children">
								<a href="#">Pages</a>
								<ul>
									<li><a href="#">Instructor</a></li>
									<li><a href="#">Instructor Details</a></li>
									<li><a href="#">Pricing Plan</a></li>
									<li><a href="#">Faq Page</a></li>
									<li><a href="#">404</a></li>
								</ul>
							</li>
							<li class="menu-item-has-children">
								<a href="#">Blog</a>
								<ul>
									<li><a href="#">Blog</a></li>
									<li><a href="#">Blog Details</a></li>
								</ul>
							</li>
							<li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
						</ul>
					</nav>
				</div>

				<div class="col-20 d-none d-xl-block text-end align-self-center">
					<a href="@Url.Action("Login", "Home")" class="header-btn">Sign In</a>
					<a href="@Url.Action("Register", "Home")" class="btn_one">Sign Up</a>
				</div>

				<ul class="mobile_menu">
					<li><a href="@Url.Action("Index", "Home")">Home</a></li>
					<li><a href="#">About</a></li>
					<li><a href="@Url.Action("Courses", "Home")">Course</a></li>
					<li><a href="#">Pages</a></li>
					<li><a href="#">Blog</a></li>
					<li><a href="@Url.Action("Contact", "Home")">Contact</a></li>
				</ul>
			</div>
		</div>
	</div>

	<section class="section-top">
		<div class="container">
			<div class="col-lg-10 offset-lg-1 text-center">
				<div class="section-top-title wow fadeInRight" data-wow-duration="1s" data-wow-delay="0.3s" data-wow-offset="0">
					<h1>Contact Us</h1>
					<ul>
						<li><a href="@Url.Action("Index", "Home")">Home</a></li>
						<li> / Contact</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<section class="address_area section-padding">
		<div class="container">
			<div class="section-title text-center">
				<h2>Get in touch with <b>Eduleb</b></h2>
				<p>Have questions about courses, accounts, or learning plans? Send us a message and our team will help you choose the next step.</p>
			</div>
			<div class="row">
				<div class="col-lg-4 col-sm-6 col-xs-12">
					<div class="single_address sa_one text-center">
						<i class="ti-map"></i>
						<h4>Our Location</h4>
						<p>2570 Quadra Street Victoria Road, New York, Canada</p>
					</div>
				</div>
				<div class="col-lg-4 col-sm-6 col-xs-12">
					<div class="single_address sa_two text-center">
						<i class="ti-mobile"></i>
						<h4>Phone Number</h4>
						<p><a href="tel:+88457845695">+88 457 845 695</a></p>
					</div>
				</div>
				<div class="col-lg-4 col-sm-6 col-xs-12">
					<div class="single_address sa_three text-center">
						<i class="ti-email"></i>
						<h4>Email Address</h4>
						<p><a href="mailto:example@yourmail.com">example@yourmail.com</a></p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="contact_area section-padding" style="background-image: url('/assets/img/bg/shape-1.png'); background-size:cover; background-position:center center;">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.1s" data-wow-offset="0">
					<div class="section-title">
						<h2>Send a message</h2>
						<p>Complete the form and we will reply as soon as possible.</p>
					</div>
					<div class="contact">
						<form action="#" method="post">
							<div class="row">
								<div class="col-md-6">
									<label for="name">Name</label>
									<input id="name" type="text" name="name" placeholder="Your name" required>
								</div>
								<div class="col-md-6">
									<label for="email">Email</label>
									<input id="email" type="email" name="email" placeholder="Your email" required>
								</div>
								<div class="col-md-12">
									<label for="subject">Subject</label>
									<input id="subject" type="text" name="subject" placeholder="How can we help?">
								</div>
								<div class="col-md-12">
									<label for="message">Message</label>
									<textarea id="message" name="message" rows="7" placeholder="Write your message" required></textarea>
								</div>
								<div class="col-md-12">
									<button type="submit" class="btn_one">Send Message <i class="ti-arrow-top-right"></i></button>
								</div>
							</div>
						</form>
					</div>
				</div>
				<div class="col-lg-6 col-sm-12 col-xs-12 wow fadeInUp" data-wow-duration="1s" data-wow-delay="0.2s" data-wow-offset="0">
					<div class="map">
						<iframe title="Eduleb location" src="https://www.google.com/maps?q=New%20York&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
					</div>
				</div>
			</div>
		</div>
	</section>

	<div class="footer section-padding">
		<div class="container">
			<div class="row">
				<div class="col-lg-3 col-sm-6 col-xs-12">
					<div class="single_footer">
						<a href="@Url.Action("Index", "Home")"><img src="~/assets/img/logo.png" alt="Eduleb"></a>
						<p>Learn online with practical courses, expert instructors, and support that keeps you moving.</p>
						<div class="social_profile">
							<ul>
								<li><a class="f_facebook" href="#"><i class="fa-solid fa-x"></i></a></li>
								<li><a class="f_twitter" href="#"><i class="fa-brands fa-facebook-f"></i></a></li>
								<li><a class="f_instagram" href="#"><i class="fa-brands fa-instagram"></i></a></li>
								<li><a class="f_linkedin" href="#"><i class="fa-brands fa-linkedin-in"></i></a></li>
							</ul>
						</div>
					</div>
				</div>
				<div class="col-lg-2 col-sm-6 col-xs-12">
					<div class="single_footer">
						<h4>About Eduleb</h4>
						<ul>
							<li><a href="#">About us</a></li>
							<li><a href="#">Instructor Registration</a></li>
							<li><a href="#">Become A Teacher</a></li>
							<li><a href="#">All Instructors</a></li>
							<li><a href="#">Asked Question</a></li>
							<li><a href="@Url.Action("Contact", "Home")">Contact us</a></li>
						</ul>
					</div>
				</div>
				<div class="col-lg-2 col-sm-6 col-xs-12">
					<div class="single_footer">
						<h4>Popular Courses</h4>
						<ul>
							<li><a href="#">Development</a></li>
							<li><a href="#">Arts & design</a></li>
							<li><a href="#">Visual Design</a></li>
							<li><a href="#">Graphic Design</a></li>
							<li><a href="#">Code Inspection</a></li>
							<li><a href="#">Digital Marketing</a></li>
						</ul>
					</div>
				</div>
				<div class="col-lg-3 col-sm-6 col-xs-12">
					<div class="single_footer">
						<h4>Contact Info</h4>
						<div class="sf_contact">
							<span class="ti-map"></span>
							<p>2570 Quadra Street Victoria Road, New York, Canada</p>
						</div>
						<div class="sf_contact">
							<span class="ti-mobile"></span>
							<p>+88 457 845 695</p>
						</div>
						<div class="sf_contact">
							<span class="ti-email"></span>
							<p>example@yourmail.com</p>
						</div>
					</div>
				</div>
				<div class="col-lg-2 col-sm-6 col-xs-12">
					<div class="single_footer">
						<h4>Download App</h4>
						<p>Download our app from app store and google play store.</p>
						<a href="#"><img src="~/assets/img/google-play.jpg" class="foot_img" alt="Google Play"></a>
						<a href="#"><img src="~/assets/img/app-store.jpg" class="foot_img" alt="App Store"></a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="foot_copy">
		<div class="footer_copyright">
			<p>&copy; 2026. All Rights Reserved by Eduleb.</p>
		</div>
	</div>

	<script src="~/assets/js/jquery-1.12.4.min.js"></script>
	<script src="~/assets/bootstrap/js/bootstrap.min.js"></script>
	<script src="~/assets/js/modernizr-2.8.3.min.js"></script>
	<script src="~/assets/js/jquery-simple-mobilemenu.js"></script>
	<script src="~/assets/owlcarousel/js/owl.carousel.min.js"></script>
	<script src="~/assets/js/jquery.magnific-popup.min.js"></script>
	<script src="~/assets/js/jquery.inview.min.js"></script>
	<script src="~/assets/js/scrolltopcontrol.js"></script>
	<script src="~/assets/js/wow.min.js"></script>
	<script src="~/assets/js/scripts.js"></script>
</body>
</html>
